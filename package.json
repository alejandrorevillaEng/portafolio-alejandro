{
  "name": "portafolio-alejandro-prueba1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio jugable en pixel art de Alejandro Revilla",
  "scripts": {
    "dev": "vite",
    "build": "node tools/check-assets.mjs && node tools/check-seo.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "assets": "node tools/copy-assets.mjs",
    "check:assets": "node tools/check-assets.mjs",
    "mapa": "node tools/export-map.mjs",
    "tilesets": "node tools/make-tilesets.mjs",
    "check:seo": "node tools/check-seo.mjs",
    "dev:movil": "vite --host",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "phaser": "^3.86.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
